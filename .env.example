# --- Baza ---
# Neon Postgres. Berilmasa brif va qarorlar saqlanmaydi.
DATABASE_URL=

# --- Autentifikatsiya ---
# Sessiya cookie'sini imzolash uchun sir: openssl rand -base64 32
AUTH_SECRET=
# Bitta CEO paroli. Bir nechta foydalanuvchi kerak bo'lsa AUTH_ACCOUNTS ishlating.
APP_PASSWORD=
# Ixtiyoriy JSON. Faqat "ceo" roli qaror tasdiqlaydi.
# [{"key":"ceo","name":"CEO","role":"ceo","password":"…"},{"key":"savdo","name":"Savdo rahbari","role":"manager","password":"…"}]
AUTH_ACCOUNTS=

# --- Ichki API (ma'lumot manbai) ---
# Berilmasa ilova demo ma'lumotda ishlaydi.
INTERNAL_API_URL=
INTERNAL_API_TOKEN=
INTERNAL_API_SALES_PATH=/analytics/sales
INTERNAL_API_FINANCE_PATH=/analytics/finance

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Kunlik brif va kritik ogohlantirishlar shu chatga boradi.
TELEGRAM_CEO_CHAT_ID=
# Ijrochi jamoalar JSON. Kalit agent nomiga mos bo'lsa (savdo, moliya, marketing),
# tasdiqlangan vazifa avtomatik shu jamoaga ketadi.
# [{"key":"savdo","label":"Savdo jamoasi","chatId":"-100…"}]
TELEGRAM_TEAM_CHAT_IDS=
# Zaxira ijrochi ("asosiy" jamoa sifatida ko'rinadi).
TELEGRAM_DEFAULT_EXECUTOR_CHAT_ID=
# Webhook'ning x-telegram-bot-api-secret-token sarlavhasi. Berilmasa webhook yopiq.
TELEGRAM_WEBHOOK_SECRET=

# --- Ilova ---
# Telegram xabaridagi "Panelni ochish" tugmasi uchun.
APP_URL=
# Kunlik cron himoyasi. Berilmasa cron yopiq.
CRON_SECRET=

# --- AI ---
# Lokalda AI Gateway uchun (Vercel'da OIDC token yetarli).
AI_GATEWAY_API_KEY=
